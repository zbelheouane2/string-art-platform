# Copier en .env pour le développement local. Ne jamais versionner de vrais secrets.
DATABASE_URL=postgresql://stringart:stringart@localhost:5432/stringart
ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_BRAND_NAME=DeeKra
ENGINE_TOKEN=dev-token
SESSION_SECRET=dev-only-session-secret-change-me-0000
# Google Sheet des commandes : se règle dans l'admin (Réglages → Google Sheets). Ces variables ne servent
# que tant que rien n'est enregistré dans l'admin (docs/commandes-google-sheet.md).
ORDER_SHEET_URL=
ORDER_SHEET_SECRET=
# Mettre à false pour fermer la page de commande.
NEXT_PUBLIC_ORDERING_OPEN=true
# Contact et réseaux affichés sur le site. Vide = masqué.
NEXT_PUBLIC_SUPPORT_EMAIL=deekraart@gmail.com
NEXT_PUBLIC_WHATSAPP=213771704033
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Mentions légales : récépissé de déclaration ANPDP (loi 18-07). Vide = masqué.
NEXT_PUBLIC_LEGAL_ANPDP=

# Espace admin (/admin) : mot de passe du propriétaire (identifiant « admin »), 10 caractères minimum.
# Vide = accès propriétaire fermé (les comptes créés dans l'admin restent utilisables). Voir docs/espace-admin.md.
ADMIN_PASSWORD=

# Adresse publique du site, sans « / » final (ex. https://deekra.dz) : liens absolus des aperçus
# WhatsApp/Facebook, sitemap.xml, robots.txt et adresses canoniques. Obligatoire en production.
NEXT_PUBLIC_SITE_URL=
# Mesure d'audience et pixels publicitaires (chargés seulement après accord du visiteur).
# Vide = outil désactivé ; tous vides = ni script ni bandeau de consentement.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
