# Copier en .env pour le développement local. Ne jamais versionner de vrais secrets.
DATABASE_URL=postgresql://stringart:stringart@localhost:5432/stringart
ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_BRAND_NAME=DeeKra
ENGINE_TOKEN=dev-token
SESSION_SECRET=dev-only-session-secret-change-me-0000
# Google Sheet des commandes (docs/commandes-google-sheet.md). Vide = pas d'envoi.
ORDER_SHEET_URL=
ORDER_SHEET_SECRET=
# Mettre à false pour fermer la page de commande.
NEXT_PUBLIC_ORDERING_OPEN=true
