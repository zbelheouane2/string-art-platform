// Modèle de données de la plateforme. Toute évolution passe par une migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Marché commercial : pays ou zone, avec sa devise et sa langue par défaut.
model Market {
  id            String          @id @default(cuid())
  code          String          @unique // "DZ", "FR", "EU"…
  name          String
  currency      String          @db.Char(3) // ISO 4217
  defaultLocale String
  active        Boolean         @default(true)
  prices        Price[]
  paymentMethods MarketPaymentMethod[]
  deliveryMethods DeliveryMethod[]
  orders        Order[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum ProductKind {
  KIT            // kit physique avec code inclus
  EXTRA_CODE     // code supplémentaire
  ARTWORK        // tableau fini
  ACCESSORY      // option ajoutée au kit (support, bougie…)
}

model Product {
  id        String      @id @default(cuid())
  slug      String      @unique
  kind      ProductKind
  active    Boolean     @default(true)
  /// Rupture de stock : l'article reste affiché mais ne peut plus être commandé.
  soldOut   Boolean     @default(false)
  /// Quantité en stock (null : stock non suivi). À 0, l'article passe en rupture.
  stockQuantity Int?
  /// Libellés par langue : { "fr": "...", "en": "...", "ar": "..." }
  names     Json
  prices    Price[]
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

/// Prix d'un produit sur un marché, en unité mineure (centimes, ou dinars pour DZD).
model Price {
  id          String  @id @default(cuid())
  productId   String
  marketId    String
  amountMinor Int
  currency    String  @db.Char(3)
  product     Product @relation(fields: [productId], references: [id])
  market      Market  @relation(fields: [marketId], references: [id])

  @@unique([productId, marketId])
}

/// Moyen de paiement générique (le prestataire est branché par un adaptateur).
model PaymentMethod {
  id       String                @id @default(cuid())
  code     String                @unique // "cod", "cib_edahabia", "card"…
  provider String                // identifiant de l'adaptateur
  markets  MarketPaymentMethod[]
  payments Payment[]
}

model MarketPaymentMethod {
  marketId        String
  paymentMethodId String
  active          Boolean       @default(true)
  market          Market        @relation(fields: [marketId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@id([marketId, paymentMethodId])
}

/// Mode de livraison d'un marché (le transporteur est branché par un adaptateur).
model DeliveryMethod {
  id          String  @id @default(cuid())
  marketId    String
  code        String  // "yalidine_home", "yalidine_desk"…
  provider    String
  active      Boolean @default(true)
  market      Market  @relation(fields: [marketId], references: [id])
  orders      Order[]
  rates       DeliveryRate[]

  @@unique([marketId, code])
}

/// Frais de livraison d'un mode de livraison vers une zone (wilaya en Algérie),
/// importés d'un fichier ou synchronisés avec le transporteur.
model DeliveryRate {
  id               String         @id @default(cuid())
  deliveryMethodId String
  /// Code de zone : numéro de wilaya « 01 »…« 69 » pour l'Algérie.
  zone             String
  amountMinor      Int
  currency         String         @db.Char(3)
  /// Origine du tarif : « fichier », « zrexpress »…
  source           String
  deliveryMethod   DeliveryMethod @relation(fields: [deliveryMethodId], references: [id])
  updatedAt        DateTime       @updatedAt

  @@unique([deliveryMethodId, zone])
}

model Customer {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?
  fullName  String
  locale    String   @default("fr")
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id               String          @id @default(cuid())
  number           String          @unique
  status           OrderStatus     @default(PENDING)
  customerId       String
  marketId         String
  deliveryMethodId String?
  currency         String          @db.Char(3)
  /// Frais de livraison retenus à la commande (null : à confirmer par téléphone).
  deliveryFeeMinor Int?
  /// Total articles − remise + livraison connue.
  totalMinor       Int
  /// Code promo appliqué (en majuscules) et remise accordée sur les articles.
  promoCode        String?
  discountMinor    Int             @default(0)
  /// Adresse figée au moment de la commande.
  shippingAddress  Json
  /// Envoi réussi de la ligne vers la Google Sheet (null : pas encore envoyée).
  sheetSentAt      DateTime?
  customer         Customer        @relation(fields: [customerId], references: [id])
  market           Market          @relation(fields: [marketId], references: [id])
  deliveryMethod   DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id             String           @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceMinor Int
  order          Order            @relation(fields: [orderId], references: [id])
  product        Product          @relation(fields: [productId], references: [id])
  codes          ActivationCode[]
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  paymentMethodId String
  status          PaymentStatus @default(PENDING)
  amountMinor     Int
  currency        String        @db.Char(3)
  providerRef     String?
  order           Order         @relation(fields: [orderId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum ActivationCodeStatus {
  ACTIVE     // utilisable
  USED       // portrait validé
  DISABLED   // désactivé (abus, remboursement, limite d'envois atteinte)
}

/// Code d'activation au format XXXX-XXXX, imprimé dans le kit.
model ActivationCode {
  id           String               @id @default(cuid())
  code         String               @unique
  status       ActivationCodeStatus @default(ACTIVE)
  /// Lot d'impression (ex. « 2026-11-A »), pour retrouver et exporter les codes d'une série.
  batch        String?
  orderItemId  String?
  /// Nombre d'envois des instructions par e-mail (limite configurable).
  emailsSent   Int                  @default(0)
  redeemedAt   DateTime?
  orderItem    OrderItem?           @relation(fields: [orderItemId], references: [id])
  generations  Generation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([batch])
}

enum GenerationStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Calcul d'un portrait par le moteur. La photo est stockée à part (stockage privé)
/// et supprimée à `photoDeleteAfter` ; seule son empreinte reste.
model Generation {
  id               String           @id @default(cuid())
  activationCodeId String
  status           GenerationStatus @default(QUEUED)
  variant          String
  engineVersion    String?
  photoSha256      String           @db.Char(64)
  photoKey         String?          // clé dans le stockage privé, null une fois supprimée
  photoDeleteAfter DateTime
  params           Json
  /// Document d'instructions renvoyé par le moteur (séquence, étapes, métriques).
  document         Json?
  chosen           Boolean          @default(false)
  /// Avancement du guide (fils déjà posés), pour reprendre sur n'importe quel appareil.
  guideStep        Int              @default(0)
  guideStepAt      DateTime?
  /// Dernier fil atteint (portrait terminé) : point de départ du délai avant effacement.
  guideDoneAt      DateTime?
  /// Instructions (séquence) effacées pour libérer la base ; la trace du portrait reste.
  purgedAt         DateTime?
  error            String?
  activationCode   ActivationCode   @relation(fields: [activationCodeId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([activationCodeId])
  @@index([photoDeleteAfter])
  @@index([guideDoneAt])
}

/// Journal des opérations importantes (sans données personnelles en clair).
model AuditLog {
  id        String   @id @default(cuid())
  actor     String   // "system", "customer:<id>", "admin:<id>"
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

enum PromoKind {
  PERCENT
  FIXED
}

/// Sur quoi porte la remise : le kit seul, tous les articles, ou la livraison.
enum PromoScope {
  KIT
  ORDER
  SHIPPING
}

/// Code promo saisi à la commande. La remise porte sur les articles (pas sur la livraison).
model PromoCode {
  id          String    @id @default(cuid())
  /// En majuscules, sans espaces (« BIENVENUE10 »).
  code        String    @unique
  kind        PromoKind
  scope       PromoScope @default(ORDER)
  /// Pourcentage (1 à 100) ou montant en unité mineure.
  value       Int
  /// Montant minimal des articles pour utiliser le code (unité mineure).
  minOrderMinor   Int?
  /// Utilisations maximales par client (même numéro de téléphone).
  maxUsesPerPhone Int?
  /// Note interne (campagne, partenaire…), jamais affichée au client.
  note        String?
  currency    String?   @db.Char(3)
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Nombre maximal d'utilisations (null : illimité).
  maxUses     Int?
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Société de livraison (ZR Express, Yalidine…). Ses modes de livraison
/// (DeliveryMethod.provider = code) portent les tarifs par wilaya.
model Carrier {
  id             String    @id @default(cuid())
  /// Identifiant technique (« zrexpress ») : préfixe des modes « zrexpress_home » / « zrexpress_desk ».
  code           String    @unique
  name           String
  /// Logo (chemin public ou URL https), facultatif.
  logoUrl        String?
  active         Boolean   @default(true)
  /// Dernière mise à jour des tarifs (import ou modification).
  ratesUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/* ---------------- Espace admin étendu ---------------- */

/** Rôle d'un compte de l'espace admin : accès total, ou employé (commandes, stock, avis, annonce, FAQ). */
enum AdminRole {
  ADMIN
  EMPLOYEE
}

/**
 * Compte nominatif de l'espace admin. Le propriétaire garde en plus l'accès par
 * ADMIN_PASSWORD (variable d'environnement), qui ne peut pas être supprimé d'ici.
 */
model AdminUser {
  id             String    @id @default(cuid())
  /// Identifiant de connexion, en minuscules (« karim », « sara.dz »).
  login          String    @unique
  name           String
  role           AdminRole @default(EMPLOYEE)
  /// Empreinte scrypt « sel:empreinte » (jamais le mot de passe en clair).
  passwordHash   String
  active         Boolean   @default(true)
  /// Incrémenté au changement de mot de passe ou à la désactivation : déconnecte les sessions ouvertes.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/** Réglage modifiable depuis l'admin (annonce, contacts, Google Sheet, photos…), en JSON. */
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/** Texte du site modifié dans l'admin : remplace la valeur du fichier messages/<langue>.json. */
model ContentOverride {
  locale    String
  /// Clé de traduction (« hero.titleStart », « faq.items.who.q »).
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([locale, key])
}

/** Image téléversée depuis l'admin (photos du site, avant/après, avis). Servie par /media/<id>. */
model MediaAsset {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  size      Int
  sha256    String   @db.Char(64)
  /// Nom d'origine, pour s'y retrouver dans la médiathèque.
  name      String
  createdBy String?
  createdAt DateTime @default(now())
}

/** Exemple avant/après de la fiche du kit (photo ↔ portrait en fil), ordonné. */
model ShowcaseExample {
  id        String   @id @default(cuid())
  photoUrl  String
  threadUrl String
  /// Légende par langue : { "fr": "...", "en": "...", "ar": "..." }
  labels    Json
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/** Avis client : publié sur l'accueil seulement après validation dans l'admin. */
model CustomerReview {
  id          String       @id @default(cuid())
  /// Commande livrée qui justifie l'avis (avis laissés depuis le site).
  orderNumber String?
  /// Prénom tel que le client accepte de l'afficher.
  name        String
  place       String?
  rating      Int
  text        String
  locale      String       @default("fr")
  photoUrl    String?
  status      ReviewStatus @default(PENDING)
  /// « site » (laissé par le client) ou « admin » (saisi à partir d'un message reçu).
  source      String       @default("site")
  moderatedBy String?
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
}
