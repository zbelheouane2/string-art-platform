# Copier en .env sur le serveur et remplir. Ne jamais envoyer ce fichier rempli par e-mail ni le versionner.
# Mots de passe : au moins 32 caractères, inventés (ex. commande : openssl rand -hex 24).

# Nom de domaine du site, sans https:// ni www (ex. deekra.dz)
DOMAIN=
POSTGRES_PASSWORD=
ENGINE_TOKEN=
SESSION_SECRET=
# Mot de passe de /admin, 10 caractères minimum. Vide = admin fermé.
ADMIN_PASSWORD=

# Google Sheet des commandes (docs/commandes-google-sheet.md). Vide = pas d'envoi.
ORDER_SHEET_URL=
ORDER_SHEET_SECRET=

# Réglages publics : relancer avec --build après modification.
NEXT_PUBLIC_BRAND_NAME=DeeKra
NEXT_PUBLIC_ORDERING_OPEN=true
NEXT_PUBLIC_SUPPORT_EMAIL=deekraart@gmail.com
NEXT_PUBLIC_WHATSAPP=213771704033
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LEGAL_ANPDP=

# Oracle Cloud « Always Free » : décommenter les deux lignes (voir docs/hebergement-oracle.md).
# COMPOSE_PROFILES=oracle
# KEEPALIVE_MB=3000
